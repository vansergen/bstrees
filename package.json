{
  "name": "bstrees",
  "version": "2.0.0",
  "description": "Sorted sets backed by binary search trees (AVL and unbalanced)",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "MIGRATION.md",
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vansergen/bstrees.git"
  },
  "keywords": [
    "avl tree",
    "binary search tree",
    "bstree",
    "ordered set",
    "sorted set",
    "tree"
  ],
  "author": "Sergey Bakulin <sergey.bakulin.github@gmail.com>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/vansergen/bstrees/issues"
  },
  "homepage": "https://github.com/vansergen/bstrees#readme",
  "scripts": {
    "bench": "node --import tsx bench/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:remove": "rm -rf dist",
    "ci:all": "npm ci && npm run prettier && npm run eslint && npm run typecheck && npm run commitlint && npm run coverage && npm run test:package && npm run lint:package && npm run docs:build",
    "commitlint": "commitlint --verbose --from=$( git rev-list --max-parents=0 $( git rev-parse --abbrev-ref HEAD ) )",
    "coverage": "mkdir -p coverage && node --import tsx --enable-source-maps --test --test-isolation=none --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\"",
    "docs:build": "typedoc",
    "eslint": "eslint .",
    "eslint:fix": "npm run eslint -- --fix",
    "install:clean": "npm install",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "prebuild": "npm run build:remove",
    "preinstall:clean": "rm -rf node_modules package-lock.json",
    "prepack": "npm run build",
    "prepare": "husky",
    "prettier": "prettier -c .",
    "prettier:write": "prettier -c -w .",
    "preversion": "npm run docs:build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:package": "node --import tsx scripts/check-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@binden/commitlint-config": "^3.0.0",
    "@binden/eslint-config-ts": "^6.0.2",
    "@binden/semantic-release-config": "^3.0.4",
    "@binden/tsconfig": "^4.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tinybench": "^6.2.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-5.6": "npm:typescript@5.6.3",
    "typescript-5.8": "npm:typescript@5.8.3"
  }
}
